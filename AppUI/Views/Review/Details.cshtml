@model ReviewDetailsVm
<section class="row">
    <article class="me-2">
        <h2>
            <a asp-controller="Reviewer" asp-action="Details" asp-route-id="@Model.ReviewerId">@Html.DisplayFor(m => Model.Reviewer)</a>
        </h2>
    </article>
    <article class="me-2">
        <dl>
            <dt>Video game: </dt>
            <a asp-controller="VideoGame" asp-action="Details" asp-route-id="@Model.VideoGameId">@Html.DisplayFor(m => Model.VideoGame)</a>
            <dt>Content:</dt>
            <dd>@Html.DisplayFor(m => Model.Content)</dd>
        </dl>
    </article>
</section>
<div>
    <a asp-action="Index" asp-route-id="@Model.VideoGameId">Back to list</a>
</div>