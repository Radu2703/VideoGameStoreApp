@model IEnumerable<AppUI.Models.ViewModels.CardPublisherVm>
<article class="me-2">
    <h1>Publishers</h1>
</article>
<section class="row">
    @if (Model.Count() > 0)
    {
        @foreach (var item in Model)
        {
            <article class="me-2 col-lg-3">
                @await Html.PartialAsync("Publisher/_Card", item)
            </article>
        }
    }
    else
    {
        <article class="alert alert-warning" role="alert">There is no registered publisher yet!</article>
    }
</section>